rules_version = '2';
// AP 레슨 노트 · 데이터 접근 규칙
// - 선수: 자기 기록(players/{uid}/...)만 읽고 쓴다.
// - 코치·관리자: 모든 선수 기록을 읽고, 훈련 라이브러리를 고친다.
// - 역할(users/{uid}.role)은 관리자만 바꾼다. 본인은 처음 가입할 때 player 로만 만든다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isStaff() { return signedIn() && role() in ['coach', 'admin']; }
    function isAdmin() { return signedIn() && role() == 'admin'; }

    // 나이 구분(ageBand: adult|teen|child)은 본인이 한 번만 정한다. 보호자 확인(guardianVerified)은 코치·관리자만.
    function same(f) { return request.resource.data.get(f, null) == resource.data.get(f, null); }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'player'
                      && !('guardianVerified' in request.resource.data);
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid && same('role') && same('guardianVerified')
                        && same('verifiedBy') && (resource.data.get('ageBand', null) == null || same('ageBand')))
                    || (isStaff() && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['guardianVerified', 'verifiedBy', 'verifiedAt']));
    }

    // 오늘의 대화 기록: 서버 함수만 쓴다. 본인과 코치·관리자가 읽는다.
    match /players/{uid}/chats/{id} {
      allow read: if (signedIn() && request.auth.uid == uid) || isStaff();
      allow write: if false;
    }

    // 만 14세 미만 선수의 보호자 정보: 본인과 코치·관리자만 본다
    match /guardians/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isStaff();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /players/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isStaff();
      match /coaches/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isStaff();
      }
      match /lessons/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isStaff();
      }
    }

    match /library/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // 사용량은 서버 함수만 쓴다
    match /usage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
