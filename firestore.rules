rules_version = '2';
// AP 레슨 노트 · 데이터 접근 규칙
// - 선수: 자기 기록(players/{uid}/...)만 읽고 쓴다.
// - 코치·관리자: 모든 선수 기록을 읽고, 훈련 라이브러리를 고친다.
// - 역할(users/{uid}.role)은 관리자만 바꾼다. 본인은 처음 가입할 때 player 로만 만든다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isStaff() { return signedIn() && role() in ['coach', 'admin']; }
    function isAdmin() { return signedIn() && role() == 'admin'; }

    // 나이 구분(ageBand: adult|teen|child)은 본인이 한 번만 정한다. 보호자 확인(guardianVerified)은 코치·관리자만.
    function same(f) { return request.resource.data.get(f, null) == resource.data.get(f, null); }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'player'
                      && !('guardianVerified' in request.resource.data);
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid && same('role') && same('guardianVerified')
                        && same('verifiedBy') && (resource.data.get('ageBand', null) == null || same('ageBand')))
                    || (isStaff() && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['guardianVerified', 'verifiedBy', 'verifiedAt']));
    }

    // 공동 레거시 나무: 집계 숫자는 누구나(첫 화면 광장), 포인트와 출처는 로그인한 사람이 본다. 쓰기는 서버만.
    match /legacy/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /legacyPoints/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /legacyCoaches/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    // 레슨 정리 때 서버가 보관한 새 포인트 원본 (서버 전용)
    match /players/{uid}/drafts/{id} {
      allow read, write: if false;
    }

    // 오늘의 대화 기록: 서버 함수만 쓴다. 본인과 코치·관리자가 읽는다.
    match /players/{uid}/chats/{id} {
      allow read: if (signedIn() && request.auth.uid == uid) || isStaff();
      allow write: if false;
    }

    // 만 14세 미만 선수의 보호자 정보: 본인과 코치·관리자만 본다
    match /guardians/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isStaff();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /players/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isStaff();
      match /statement/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isStaff();
      }
      // AI 훈련 카드: 제안·내부 연결·검토는 서버만 쓴다. 본인·코치는 수정본·수행 기록·상태만 덧붙인다(지우지 못함).
      match /trainings/{id} {
        allow read: if (signedIn() && request.auth.uid == uid) || isStaff();
        allow create, delete: if false;
        allow update: if ((signedIn() && request.auth.uid == uid) || isStaff())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['adjustments', 'runs', 'status', 'current', 'updatedAt', 'compat', 'events'])
          && request.resource.data.adjustments.size() >= resource.data.adjustments.size()
          && request.resource.data.runs.size() >= resource.data.runs.size()
          && request.resource.data.events.size() >= resource.data.events.size()
          && request.resource.data.status in ['proposed', 'applied', 'skipped', 'stopped', 'done'];
      }
      match /coaches/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isStaff();
      }
      match /lessons/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isStaff();
      }
    }

    // 운영 지표(추천 채택률 등)용: 코치·관리자는 모든 선수의 훈련 카드를 모아 읽는다
    match /{path=**}/trainings/{id} {
      allow read: if isStaff();
    }

    match /library/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // 사용량은 서버 함수만 쓴다
    match /usage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
