rules_version = '2';
// AP 레슨 노트 · 데이터 접근 규칙
// - 선수: 자기 기록(players/{uid}/...)만 읽고 쓴다.
// - 코치·관리자: 모든 선수 기록을 읽고, 훈련 라이브러리를 고친다.
// - 역할(users/{uid}.role)은 관리자만 바꾼다. 본인은 처음 가입할 때 player 로만 만든다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isStaff() { return signedIn() && role() in ['coach', 'admin']; }
    function isAdmin() { return signedIn() && role() == 'admin'; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'player';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
                      && request.resource.data.role == resource.data.role);
    }

    match /players/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isStaff();
      match /{sub=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isStaff();
      }
    }

    match /library/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // 사용량은 서버 함수만 쓴다
    match /usage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
